# Local-only Migration Service environment example.
# Production deployment generates MIGRATION_APP_KEY once in the server .env.
APP_KEY=
MIGRATION_APP_KEY=
EMPLOYEES_URL=http://employees:8000/api

# Private migration metadata. Do not point this at a business-service database.
DB_CONNECTION=sqlite
DB_DATABASE=/data/migration.sqlite
QUEUE_CONNECTION=database

# New platform PostgreSQL. Target credentials may write only to the corresponding target service schema.
TARGET_SHARED_DB_HOST=postgres
TARGET_SHARED_DB_DATABASE=irlix_services
TARGET_EMPLOYEES_DB_PORT=5432
TARGET_EMPLOYEES_DB_USERNAME=
TARGET_EMPLOYEES_DB_PASSWORD=
TARGET_VACATIONS_DB_PORT=5432
TARGET_VACATIONS_DB_USERNAME=
TARGET_VACATIONS_DB_PASSWORD=

# Optional CLI fallback. The web admin console stores legacy credentials encrypted in its private
# metadata DB and does not require these values. If CLI fallback is used, a dedicated read-only role
# is mandatory and the confirmation flag must be true.
LEGACY_EMPLOYEES_DB_HOST=
LEGACY_EMPLOYEES_DB_PORT=5432
LEGACY_EMPLOYEES_DB_DATABASE=
LEGACY_EMPLOYEES_DB_USERNAME=
LEGACY_EMPLOYEES_DB_PASSWORD=
LEGACY_EMPLOYEES_DB_SSLMODE=disable
LEGACY_EMPLOYEES_DB_READ_ONLY_CONFIRMED=false

LEGACY_VACATIONS_DB_HOST=
LEGACY_VACATIONS_DB_PORT=5432
LEGACY_VACATIONS_DB_DATABASE=
LEGACY_VACATIONS_DB_USERNAME=
LEGACY_VACATIONS_DB_PASSWORD=
LEGACY_VACATIONS_DB_SSLMODE=disable
LEGACY_VACATIONS_DB_READ_ONLY_CONFIRMED=false

# Hard query timeout for every legacy SELECT.
LEGACY_STATEMENT_TIMEOUT_MS=15000